# Server-only SMTP credentials (Zoho). Never prefix these with NEXT_PUBLIC_.
SMTP_USER=you@example.com
SMTP_PASSWORD=app-password

# Address that receives contact form messages (defaults to SMTP_USER)
APP_EMAIL=you@example.com

# Optional: Umami analytics
NEXT_PUBLIC_UMAMI_URL=
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# Vercel Blob store holding the resume PDF (added automatically on Vercel when the store is connected)
PORTFOLIO_READ_WRITE_TOKEN=vercel_blob_rw_your-token

# Optional: fallback colour theme id from src/config/themes.ts (midnight, emerald, indigo, graphite, amber).
# Used until a theme is saved in /admin, and whenever Redis is unreachable.
SITE_THEME=indigo

# Private /admin area: the single admin account. Server-only; never prefix these with NEXT_PUBLIC_.
ADMIN_USERNAME=
# Use a long, unique password.
ADMIN_PASSWORD=
# Signs the admin session cookie. At least 32 characters, e.g. `openssl rand -base64 32`.
# Changing it signs every session out.
SESSION_SECRET=

# Upstash Redis (Vercel Marketplace) holding the /admin settings. Added automatically on Vercel when the
# database is connected. UPSTASH_REDIS_REST_URL / UPSTASH_REDIS_REST_TOKEN are accepted instead.
PORTFOLIO_KV_REST_API_URL=
PORTFOLIO_KV_REST_API_TOKEN=
